{
  "name": "neuro-effort-course",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interaktivní kurz: Neurokognitivní psychologie úsilí, motivace a změny chování",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:audit-mcq": "tsx scripts/audit-mcq-bias.ts",
    "check": "npm run lint && npm run typecheck && npm run content:validate && npm run content:audit-mcq && npm run test:run && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "dexie": "^4.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
