# Copy this file to .env.local and fill in the values from your Supabase project.
# .env.local is git-ignored and must never be committed.
#
# The browser application uses ONLY the two VITE_SUPABASE_* values below.
# Never put a service-role key, a secret key (sb_secret_...), or the database
# password into any VITE_* variable — everything prefixed with VITE_ is embedded
# into the public JavaScript bundle.

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Publishable (anon) key. Safe for browsers ONLY in combination with Row Level
# Security, which migration 0001 enables on every user-data table.
VITE_SUPABASE_PUBLISHABLE_KEY=

# When false the application shows no public registration form and an
# administrator creates users manually in the Supabase Dashboard.
VITE_ALLOW_SIGNUP=false

# Optional. Overrides the GitHub Pages base path detection (see vite.config.ts).
# Leave empty for local development.
# VITE_BASE_PATH=/neuro-effort-course/
