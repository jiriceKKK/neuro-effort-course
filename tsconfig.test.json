{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    // Tests read the SQL migration from disk and stub globals, so they need Node types.
    // Application code deliberately does not — `process` must not leak into the bundle.
    "types": ["vite/client", "node"]
  },
  "include": ["tests", "src/vite-env.d.ts"]
}
